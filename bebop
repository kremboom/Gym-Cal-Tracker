<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>30-Day Physique Recomp Tracker</title>
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --accent: #38bdf8;
            --accent-hover: #0284c7;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --border: #334155;
            --success: #22c55e;
            --danger: #ef4444;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            padding: 1rem;
            max-width: 1000px;
            margin: 0 auto;
            padding-bottom: 5rem;
        }

        header {
            text-align: center;
            margin-bottom: 1.5rem;
        }

        h1 {
            font-size: 1.8rem;
            color: var(--accent);
            margin-bottom: 0.25rem;
        }

        p.subtitle {
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .stat-card {
            background: var(--card-bg);
            padding: 1rem;
            border-radius: 12px;
            border: 1px solid var(--border);
            text-align: center;
        }

        .stat-card h3 {
            font-size: 0.8rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 0.25rem;
        }

        .stat-card p {
            font-size: 1.4rem;
            font-weight: bold;
            color: var(--accent);
        }

        /* Nav Tabs */
        .tabs {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 1.5rem;
            background: var(--card-bg);
            padding: 0.5rem;
            border-radius: 12px;
            border: 1px solid var(--border);
            overflow-x: auto;
        }

        .tab-btn {
            flex: 1;
            padding: 0.75rem 1rem;
            background: transparent;
            border: none;
            color: var(--text-muted);
            font-weight: 600;
            border-radius: 8px;
            cursor: pointer;
            white-space: nowrap;
            transition: all 0.2s;
        }

        .tab-btn.active {
            background: var(--accent);
            color: #000;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        /* Day Selector */
        .day-picker {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: var(--card-bg);
            padding: 0.75rem 1rem;
            border-radius: 12px;
            border: 1px solid var(--border);
            margin-bottom: 1.5rem;
        }

        .day-btn {
            background: var(--border);
            color: var(--text-main);
            border: none;
            padding: 0.5rem 1rem;
            border-radius: 6px;
            cursor: pointer;
        }

        /* Workout Table */
        .routine-header {
            margin-bottom: 1rem;
            padding: 1rem;
            background: rgba(56, 189, 248, 0.1);
            border-left: 4px solid var(--accent);
            border-radius: 4px;
        }

        .exercise-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 1rem;
            margin-bottom: 1rem;
        }

        .exercise-title {
            font-weight: bold;
            font-size: 1.1rem;
            margin-bottom: 0.5rem;
            color: var(--accent);
        }

        .set-row {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 0.5rem;
        }

        .set-row span {
            width: 50px;
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        input[type="number"], input[type="text"] {
            background: var(--bg-color);
            border: 1px solid var(--border);
            color: var(--text-main);
            padding: 0.4rem 0.6rem;
            border-radius: 6px;
            width: 100%;
        }

        .check-btn {
            background: var(--border);
            color: white;
            border: none;
            padding: 0.4rem 0.8rem;
            border-radius: 6px;
            cursor: pointer;
        }

        .check-btn.completed {
            background: var(--success);
        }

        /* Macros Tracker */
        .macro-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 1.2rem;
            margin-bottom: 1rem;
        }

        .progress-bar-bg {
            background: var(--bg-color);
            height: 10px;
            border-radius: 5px;
            overflow: hidden;
            margin-top: 0.5rem;
        }

        .progress-bar-fill {
            background: var(--accent);
            height: 100%;
            width: 0%;
            transition: width 0.3s;
        }

        .meal-log {
            margin-top: 1rem;
        }

        /* Photos Section */
        .photo-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 1rem;
            margin-top: 1rem;
        }

        .photo-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 12px;
            overflow: hidden;
        }

        .photo-card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

        .photo-card-info {
            padding: 0.75rem;
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        /* Forms */
        .form-group {
            margin-bottom: 1rem;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.3rem;
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .btn-primary {
            background: var(--accent);
            color: #000;
            border: none;
            padding: 0.75rem 1.5rem;
            font-weight: bold;
            border-radius: 8px;
            cursor: pointer;
            width: 100%;
        }

        .btn-primary:hover {
            background: var(--accent-hover);
        }
    </style>
</head>
<body>

    <header>
        <h1>30-Day Physique Recomposition</h1>
        <p class="subtitle">5'8" | 152 lbs Target Recomp</p>
    </header>

    <!-- Overview Stats -->
    <div class="stats-grid">
        <div class="stat-card">
            <h3>Current Day</h3>
            <p id="stat-day">Day 1 / 30</p>
        </div>
        <div class="stat-card">
            <h3>Completed Sets</h3>
            <p id="stat-sets">0</p>
        </div>
        <div class="stat-card">
            <h3>Calories Today</h3>
            <p id="stat-cals">0 / 2200</p>
        </div>
        <div class="stat-card">
            <h3>Photos Uploaded</h3>
            <p id="stat-photos">0</p>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="tabs">
        <button class="tab-btn active" onclick="switchTab('workout')">Workouts</button>
        <button class="tab-btn" onclick="switchTab('nutrition')">Nutrition</button>
        <button class="tab-btn" onclick="switchTab('photos')">Progress Photos</button>
        <button class="tab-btn" onclick="switchTab('analytics')">Analytics</button>
    </div>

    <!-- Day Picker Banner -->
    <div class="day-picker">
        <button class="day-btn" onclick="changeDay(-1)">&larr; Prev Day</button>
        <span id="day-title" style="font-weight: bold;">Day 1</span>
        <button class="day-btn" onclick="changeDay(1)">Next Day &rarr;</button>
    </div>

    <!-- TAB 1: WORKOUTS -->
    <div id="workout-tab" class="tab-content active">
        <div id="routine-banner" class="routine-header">
            <h2 id="routine-name">Workout Routine</h2>
            <p id="routine-focus" style="font-size: 0.85rem; color: var(--text-muted);"></p>
        </div>
        <div id="exercise-list"></div>
    </div>

    <!-- TAB 2: NUTRITION -->
    <div id="nutrition-tab" class="tab-content">
        <div class="macro-card">
            <h3>Daily Calorie Target: <span id="cal-count">0</span> / 2200 kcal</h3>
            <div class="progress-bar-bg">
                <div id="cal-bar" class="progress-bar-fill"></div>
            </div>
        </div>

        <div class="macro-card" style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.5rem; text-align: center;">
            <div>
                <h4>Protein</h4>
                <p id="p-count" style="color:var(--accent);">0 / 150g</p>
            </div>
            <div>
                <h4>Carbs</h4>
                <p id="c-count" style="color:var(--accent);">0 / 220g</p>
            </div>
            <div>
                <h4>Fat</h4>
                <p id="f-count" style="color:var(--accent);">0 / 70g</p>
            </div>
        </div>

        <div class="macro-card">
            <h3>Log Meal / Food</h3>
            <div style="display: flex; gap: 0.5rem; margin-top: 0.5rem;">
                <input type="text" id="meal-name" placeholder="Meal name (e.g. Chicken Rice)">
                <input type="number" id="meal-cals" placeholder="Calories">
                <input type="number" id="meal-prot" placeholder="Protein (g)">
                <button class="btn-primary" style="width: auto;" onclick="addMeal()">Add</button>
            </div>
            <div id="meal-list" class="meal-log"></div>
        </div>
    </div>

    <!-- TAB 3: PHOTOS -->
    <div id="photos-tab" class="tab-content">
        <div class="macro-card">
            <h3>Upload Progress Photo</h3>
            <div class="form-group" style="margin-top: 0.5rem;">
                <label>Select Photo</label>
                <input type="file" id="photo-input" accept="image/*">
            </div>
            <div class="form-group">
                <label>Current Weight (lbs)</label>
                <input type="number" id="photo-weight" value="152">
            </div>
            <div class="form-group">
                <label>Notes / Observations</label>
                <input type="text" id="photo-notes" placeholder="e.g. Morning photo, feeling good">
            </div>
            <button class="btn-primary" onclick="uploadPhoto()">Save Photo Entry</button>
        </div>

        <h3 style="margin-top: 1.5rem;">Progress Gallery</h3>
        <div id="photo-gallery" class="photo-grid"></div>
    </div>

    <!-- TAB 4: ANALYTICS -->
    <div id="analytics-tab" class="tab-content">
        <div class="macro-card">
            <h3>Weight Trend Over 30 Days</h3>
            <canvas id="weightChart" style="max-height: 250px;"></canvas>
        </div>
    </div>

    <script>
        // Default Workouts Schedule based on uploaded routines
        const workoutRoutines = {
            1: {
                name: "Wednesday – Upper Body Strength",
                focus: "Focus: Upper-body strength, balanced pushing & pulling, and shoulder stability.",
                exercises: [
                    { name: "Dumbbell Bench Press", sets: 3, reps: "8-10" },
                    { name: "Lat Pulldown", sets: 3, reps: "10" },
                    { name: "Seated Cable Row", sets: 3, reps: "10" },
                    { name: "Incline Dumbbell Press", sets: 2, reps: "10" },
                    { name: "Dumbbell Shoulder Press", sets: 2, reps: "10" },
                    { name: "Lateral Raises", sets: 2, reps: "12" },
                    { name: "Plank", sets: 2, reps: "30-45 sec" }
                ]
            },
            2: {
                name: "Thursday – Lower Body + Core",
                focus: "Focus: Leg strength, hip stability, balance, and core control.",
                exercises: [
                    { name: "Goblet Squat", sets: 3, reps: "10" },
                    { name: "Romanian Deadlift", sets: 3, reps: "10" },
                    { name: "Leg Press", sets: 2, reps: "10" },
                    { name: "Hamstring Curl", sets: 2, reps: "12" },
                    { name: "Standing Calf Raises", sets: 3, reps: "12" },
                    { name: "Pallof Press", sets: 2, reps: "12" },
                    { name: "Dead Bugs", sets: 2, reps: "10" }
                ]
            },
            3: {
                name: "Friday – Full Body + Athletic Conditioning",
                focus: "Focus: Full body explosive strength, conditioning, and cardiovascular stamina.",
                exercises: [
                    { name: "Bulgarian Split Squats", sets: 2, reps: "8 each leg" },
                    { name: "Assisted Pull-ups", sets: 3, reps: "8" },
                    { name: "Incline Dumbbell Press", sets: 2, reps: "10" },
                    { name: "Hip Thrusts", sets: 3, reps: "10" },
                    { name: "Face Pulls", sets: 2, reps: "12" },
                    { name: "Farmer Carries", sets: 3, reps: "30 sec" },
                    { name: "Finisher: Cycling/Rowing", sets: 1, reps: "10 mins total" }
                ]
            }
        };

        let currentDay = 1;
        let trackerData = JSON.parse(localStorage.getItem('fitnessTracker30')) || {
            logs: {},
            photos: []
        };

        function init() {
            renderDay();
            renderPhotos();
            initChart();
        }

        function switchTab(tabName) {
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
            
            event.target.classList.add('active');
            document.getElementById(`${tabName}-tab`).classList.add('active');
        }

        function changeDay(delta) {
            if (currentDay + delta >= 1 && currentDay + delta <= 30) {
                currentDay += delta;
                renderDay();
            }
        }

        function renderDay() {
            document.getElementById('stat-day').innerText = `Day ${currentDay} / 30`;
            document.getElementById('day-title').innerText = `Day ${currentDay}`;

            // Map day 1, 2, 3 pattern repeatedly
            const routineKey = ((currentDay - 1) % 3) + 1;
            const routine = workoutRoutines[routineKey];

            document.getElementById('routine-name').innerText = routine.name;
            document.getElementById('routine-focus').innerText = routine.focus;

            const listContainer = document.getElementById('exercise-list');
            listContainer.innerHTML = '';

            const dayLog = trackerData.logs[currentDay] || { exercises: {}, meals: [], cals: 0, prot: 0 };

            routine.exercises.forEach((ex, exIdx) => {
                const card = document.createElement('div');
                card.className = 'exercise-card';
                card.innerHTML = `<div class="exercise-title">${ex.name} (${ex.sets} sets x ${ex.reps})</div>`;

                for (let s = 1; s <= ex.sets; s++) {
                    const setKey = `${exIdx}_${s}`;
                    const setVal = dayLog.exercises[setKey] || { weight: '', reps: '', done: false };

                    const setRow = document.createElement('div');
                    setRow.className = 'set-row';
                    setRow.innerHTML = `
                        <span>Set ${s}</span>
                        <input type="number" placeholder="lbs" value="${setVal.weight}" onchange="saveSet(${exIdx}, ${s}, 'weight', this.value)">
                        <input type="number" placeholder="reps" value="${setVal.reps}" onchange="saveSet(${exIdx}, ${s}, 'reps', this.value)">
                        <button class="check-btn ${setVal.done ? 'completed' : ''}" onclick="toggleSetDone(${exIdx}, ${s}, this)">✓</button>
                    `;
                    card.appendChild(setRow);
                }
                listContainer.appendChild(card);
            });

            // Nutrition render
            document.getElementById('cal-count').innerText = dayLog.cals || 0;
            document.getElementById('stat-cals').innerText = `${dayLog.cals || 0} / 2200`;
            document.getElementById('cal-bar').style.width = `${Math.min(((dayLog.cals || 0) / 2200) * 100, 100)}%`;
            document.getElementById('p-count').innerText = `${dayLog.prot || 0} / 150g`;
            
            const mealList = document.getElementById('meal-list');
            mealList.innerHTML = '';
            (dayLog.meals || []).forEach(m => {
                mealList.innerHTML += `<div style="font-size:0.9rem; padding: 0.2rem 0; color: var(--text-muted);">• ${m.name}: ${m.cals} kcal, ${m.prot}g protein</div>`;
            });

            updateOverviewStats();
        }

        function saveSet(exIdx, setNum, field, val) {
            if (!trackerData.logs[currentDay]) trackerData.logs[currentDay] = { exercises: {}, meals: [], cals: 0, prot: 0 };
            const setKey = `${exIdx}_${setNum}`;
            if (!trackerData.logs[currentDay].exercises[setKey]) trackerData.logs[currentDay].exercises[setKey] = { weight: '', reps: '', done: false };
            
            trackerData.logs[currentDay].exercises[setKey][field] = val;
            saveData();
        }

        function toggleSetDone(exIdx, setNum, btn) {
            if (!trackerData.logs[currentDay]) trackerData.logs[currentDay] = { exercises: {}, meals: [], cals: 0, prot: 0 };
            const setKey = `${exIdx}_${setNum}`;
            if (!trackerData.logs[currentDay].exercises[setKey]) trackerData.logs[currentDay].exercises[setKey] = { weight: '', reps: '', done: false };
            
            trackerData.logs[currentDay].exercises[setKey].done = !trackerData.logs[currentDay].exercises[setKey].done;
            btn.classList.toggle('completed');
            saveData();
            updateOverviewStats();
        }

        function addMeal() {
            const name = document.getElementById('meal-name').value;
            const cals = parseInt(document.getElementById('meal-cals').value) || 0;
            const prot = parseInt(document.getElementById('meal-prot').value) || 0;

            if (!name || cals <= 0) return;

            if (!trackerData.logs[currentDay]) trackerData.logs[currentDay] = { exercises: {}, meals: [], cals: 0, prot: 0 };
            trackerData.logs[currentDay].meals.push({ name, cals, prot });
            trackerData.logs[currentDay].cals += cals;
            trackerData.logs[currentDay].prot += prot;

            document.getElementById('meal-name').value = '';
            document.getElementById('meal-cals').value = '';
            document.getElementById('meal-prot').value = '';

            saveData();
            renderDay();
        }

        function uploadPhoto() {
            const fileInput = document.getElementById('photo-input');
            const weight = document.getElementById('photo-weight').value;
            const notes = document.getElementById('photo-notes').value;

            if (fileInput.files && fileInput.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    trackerData.photos.push({
                        day: currentDay,
                        image: e.target.result,
                        weight: weight,
                        notes: notes,
                        date: new Date().toLocaleDateString()
                    });
                    saveData();
                    renderPhotos();
                    updateOverviewStats();
                };
                reader.readAsDataURL(fileInput.files[0]);
            }
        }

        function renderPhotos() {
            const gallery = document.getElementById('photo-gallery');
            gallery.innerHTML = '';
            trackerData.photos.forEach(p => {
                gallery.innerHTML += `
                    <div class="photo-card">
                        <img src="${p.image}">
                        <div class="photo-card-info">
                            <strong>Day ${p.day} (${p.weight} lbs)</strong><br>
                            <span>${p.notes || 'No notes'}</span>
                        </div>
                    </div>
                `;
            });
            document.getElementById('stat-photos').innerText = trackerData.photos.length;
        }

        function updateOverviewStats() {
            let totalSets = 0;
            Object.values(trackerData.logs).forEach(day => {
                if (day.exercises) {
                    Object.values(day.exercises).forEach(s => {
                        if (s.done) totalSets++;
                    });
                }
            });
            document.getElementById('stat-sets').innerText = totalSets;
        }

        function saveData() {
            localStorage.setItem('fitnessTracker30', JSON.stringify(trackerData));
        }

        function initChart() {
            const ctx = document.getElementById('weightChart').getContext('2d');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: Array.from({length: 30}, (_, i) => `Day ${i + 1}`),
                    datasets: [{
                        label: 'Weight (lbs)',
                        data: [152, 151.8, 151.5, 151.7],
                        borderColor: '#38bdf8',
                        tension: 0.3
                    }]
                },
                options: {
                    responsive: true,
                    scales: {
                        y: {
                            grid: { color: '#334155' },
                            ticks: { color: '#94a3b8' }
                        },
                        x: {
                            grid: { color: '#334155' },
                            ticks: { color: '#94a3b8' }
                        }
                    }
                }
            });
        }

        init();
    </script>
</body>
</html>